# apps/client/.env — PUBLIC (every VITE_* value ships inside the APK)
# auto = use the server at VITE_API_URL if it answers, else run the whole game in-app (offline, mock chain)
VITE_BACKEND=auto                 # auto | remote | local
VITE_API_URL=http://10.0.2.2:8787 # emulator → PC; physical phone: http://<PC_LAN_IP>:8787 or an HTTPS tunnel
VITE_WS_URL=ws://10.0.2.2:8787/ws
VITE_PRIVY_APP_ID=
VITE_CHAIN_ID=10143
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadvision.com
VITE_CHAIN_MODE=mock              # live | mock (the server decides for remote play)
VITE_DEMO=1                       # shows Guest commander + "Simulate tonight"
VITE_LANDING_HOST=realm-raiders-001.vercel.app
