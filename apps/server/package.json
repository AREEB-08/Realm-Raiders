    "@realm/game-data": "workspace:*",
    "@realm/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "undici": "6.21.1",
    "viem": "2.57.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
