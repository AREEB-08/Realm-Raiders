# Realm Raiders — environment template (§18). Copy the relevant block into
#   apps/client/.env   (PUBLIC — every VITE_* value ships in the APK)
#   apps/server/.env   (SECRET)
#   contracts/.env     (SECRET)
# Never commit real values.

# ---------- client (apps/client/.env) — public ----------
VITE_BACKEND=auto                 # auto | remote | local   (auto: use the server if it answers, else run the realm in-app)
VITE_API_URL=http://10.0.2.2:8787 # emulator → PC; phone: http://<PC_LAN_IP>:8787 or an HTTPS tunnel
VITE_WS_URL=ws://10.0.2.2:8787/ws
VITE_PRIVY_APP_ID=
VITE_CHAIN_ID=10143
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadvision.com
VITE_DEMO=1                       # shows Guest commander + "Simulate tonight"
VITE_LANDING_HOST=realm-raiders-001.vercel.app

# ---------- server (apps/server/.env) — SECRET ----------
PORT=8787
SESSION_JWT_SECRET=               # 32+ random bytes
ALLOW_DEMO_AUTH=1
DEMO=1
PRIVY_APP_ID=
PRIVY_APP_SECRET=                 # for reading the player's embedded wallet address server-side
CHAIN_MODE=mock                   # live | mock
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
RPC_URL_FALLBACK=https://rpc.ankr.com/monad_testnet
EXPLORER_URL=https://testnet.monadvision.com
RELAYER_PRIVATE_KEY=              # funded >= 15 testnet MON; RELAYER_ROLE + MINTER_ROLE + ERC-8004 referee
REALM_LEDGER_ADDRESS=             # or leave empty to use packages/shared/src/deployments.json
REALM_BADGES_ADDRESS=
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
AGENTS_MODE=offline               # live | offline
LLM_BASE_URL=                     # Model Studio URL from the console, e.g. https://<workspace>.<region>.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-flash
LLM_LOCAL_BASE_URL=               # http://localhost:11434/v1 (Ollama)
LLM_LOCAL_MODEL=qwen3:8b
LLM_TIMEOUT_MS=4000
PUBLIC_BASE_URL=http://localhost:8787   # used in agent cards, badge URIs and replay links
SIM_WORKERS=4

# ---------- contracts (contracts/.env) — SECRET ----------
ETHERSCAN_API_KEY=                # Monadscan verification (optional; Sourcify needs none)
RELAYER_ADDRESS=
BADGE_URI=https://realmraiders.pages.dev/badges/{id}.json
